# Do not put secret values in this tracked file.
# The app reads process environment; it does not automatically load .env.
TIKHUB_API_KEY=
# Conservative maximum CNY cost per HTTP request, including currency conversion.
# Must be confirmed against provider pricing; blank/zero disables paid requests.
HOTDESK_CALL_COST_CNY=
# Independently verified Xiaohongshu hot-list HTTPS feed; not a TikHub endpoint.
# Contract: {"items":[{"id":"...","title":"...","content":"...","url":"https://...","rank":1}]}
HOTDESK_XHS_HOT_FEED=
HOTDESK_SCHEDULE=1
HOTDESK_HOST=127.0.0.1
PORT=8000

# GPT-5.1 Responses + web_search. API billing is separate from ChatGPT subscriptions.
HOTDESK_OPENAI_API_KEY=
# Conservative CNY upper reservation per Responses request, including tools/tokens/FX.
HOTDESK_GPT_COST_CNY=
